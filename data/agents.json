{
  "agents": [
    {
      "type": "claude",
      "displayName": "Claude Code",
      "icon": "anthropic",
      "processName": "claude",
      "desktopApps": ["/Applications/Claude.app"],
      "sessionStrategy": "pid-json",
      "enabled": true,
      "builtIn": true,
      "paths": {
        "globalHome": "~/.claude",
        "projectDir": ".claude",
        "globalInstruction": "~/.claude/CLAUDE.md",
        "projectInstruction": "CLAUDE.md",
        "settings": "settings.json",
        "settingsFormat": "json",
        "settingsOverride": "settings.local.json",
        "skills": "skills",
        "commands": "commands",
        "agents": "agents",
        "plugins": "plugins",
        "hooks": "settings.json#hooks",
        "mcp": [".mcp.json", "settings.json#mcpServers"],
        "instructionFiles": {
          "global": ["~/.claude/CLAUDE.md"],
          "project": ["CLAUDE.md", "CLAUDE.local.md", ".claude/CLAUDE.md", ".claude/CLAUDE.local.md"]
        },
        "rulesDir": {
          "global": "~/.claude/rules",
          "project": ".claude/rules"
        }
      }
    },
    {
      "type": "codex",
      "displayName": "OpenAI Codex",
      "icon": "openai",
      "processName": "codex",
      "desktopApps": ["/Applications/Codex.app", "/Applications/CodexBar.app"],
      "sessionStrategy": "codex-jsonl",
      "enabled": true,
      "builtIn": true,
      "paths": {
        "globalHome": "~/.codex",
        "projectDir": ".codex",
        "globalInstruction": "~/.codex/AGENTS.md",
        "projectInstruction": "AGENTS.md",
        "settings": "config.toml",
        "settingsFormat": "toml",
        "settingsOverride": "AGENTS.override.md",
        "skills": "skills",
        "commands": "commands",
        "agents": "agents",
        "mcp": ["config.toml#mcp"],
        "instructionFiles": {
          "global": ["~/.codex/AGENTS.md"],
          "project": ["AGENTS.md"]
        }
      }
    },
    {
      "type": "copilot",
      "displayName": "GitHub Copilot",
      "icon": "github",
      "processName": "",
      "enabled": true,
      "builtIn": true,
      "paths": {
        "globalHome": "~/.copilot",
        "projectDir": ".github",
        "globalInstruction": "~/.copilot/instructions",
        "projectInstruction": ".github/copilot-instructions.md",
        "skills": "prompts",
        "instructionFiles": {
          "global": ["~/.copilot/instructions"],
          "project": [".github/copilot-instructions.md"]
        },
        "rulesDir": {
          "project": ".github/copilot/rules"
        }
      }
    },
    {
      "type": "opencode",
      "displayName": "OpenCode",
      "icon": "opencode",
      "processName": "opencode",
      "enabled": true,
      "builtIn": true,
      "paths": {
        "globalHome": "~/.config/opencode",
        "projectDir": ".opencode",
        "globalInstruction": "~/.config/opencode/AGENTS.md",
        "projectInstruction": "AGENTS.md",
        "settings": "opencode.json",
        "settingsFormat": "jsonc",
        "skills": "skills",
        "commands": "commands",
        "agents": "agents",
        "plugins": "plugins",
        "mcp": ["opencode.json#mcp"],
        "instructionFiles": {
          "global": ["~/.config/opencode/AGENTS.md"],
          "project": ["AGENTS.md"]
        }
      }
    }
  ]
}
